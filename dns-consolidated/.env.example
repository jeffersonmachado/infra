# ─── DNS Consolidado — variáveis de ambiente ─────────────────────────────────
# Copie para .env e preencha os valores

# pdns-auth usa backend LMDB local (volume pdns-auth-lmdb) — não depende mais
# do MariaDB em 10.10.2.99. Os dados de zona são populados via API REST
# (scripts/apply-zones-api.sh e scripts/apply-views-api.sh), usando a
# DNS_API_KEY abaixo.

# PowerDNS API key
DNS_API_KEY=CHANGE_ME_gerar_com_openssl_rand_hex_32

# dnsdist — porta de escuta
# Durante migração: 5353 (não conflita com BIND em :53)
# Corte final:      53
DNS_PORT=5353

# dnsdist escuta em 0.0.0.0 (portável entre servidores).
# IPs virtuais (10.10.2.1, 10.10.2.20) são gerenciados no HOST:
#   ip addr add 10.10.2.1/24 dev eth0
#   ip addr add 10.10.2.20/24 dev eth0

TZ=America/Sao_Paulo
