# ─── DNS Consolidado — variáveis de ambiente ─────────────────────────────────
# Copie para .env e preencha os valores

# MariaDB existente em 10.10.2.99 (mesmas credenciais do PowerDNS atual)
DNS_DB_HOST=10.10.2.99
DNS_DB_PORT=3306
DNS_DB_NAME=results
DNS_DB_USER=resultsdba
DNS_DB_PASSWORD=resu100dba

# PowerDNS API key
DNS_API_KEY=CHANGE_ME_gerar_com_openssl_rand_hex_32

# dnsdist — porta de escuta
# Durante migração: 5353 (não conflita com BIND em :53)
# Corte final:      53
DNS_PORT=5353

# IP de bind do dnsdist
# Durante migração: 0.0.0.0 (todos os IPs para testes)
# Produção:         10.10.2.1 (ou 0.0.0.0 para responder em todos)
DNS_BIND_IP=0.0.0.0

TZ=America/Sao_Paulo
