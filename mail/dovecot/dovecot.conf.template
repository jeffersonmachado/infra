disable_plaintext_auth = no
mail_privileged_group = mail
mail_location = maildir:${MAIL_STORAGE_BASE}/%d/%n/Maildir
auth_mechanisms = plain login
first_valid_uid = ${MAIL_UID}
first_valid_gid = ${MAIL_GID}
passdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf.ext
}
${DOVECOT_LDAP_PASSDB}
userdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf.ext
}
${DOVECOT_LDAP_USERDB}
service lmtp {
  inet_listener lmtp {
    address = *
    port = 24
  }
}
service auth {
  inet_listener {
    address = *
    port = 12345
  }
}
protocols = imap pop3 lmtp sieve
ssl = required
ssl_cert = <${MAIL_TLS_CERT_FILE}
ssl_key = <${MAIL_TLS_KEY_FILE}
protocol imap {
  ssl = yes
  mail_plugins = quota imap_quota imap_sieve
}
protocol pop3 {
  pop3_uidl_format = %08Xu%08Xv
}
protocol lmtp {
  mail_plugins = sieve
}
plugin {
  sieve = file:~/sieve;active=~/.dovecot.sieve
  sieve_after = /etc/dovecot/sieve/global-after.sieve
  sieve_plugins = sieve_imapsieve sieve_extprograms
  sieve_global_extensions = +vnd.dovecot.pipe +vnd.dovecot.environment
  sieve_pipe_bin_dir = /etc/dovecot/sieve

  # Learn spam when users move messages to Spam.
  imapsieve_mailbox1_name = Spam
  imapsieve_mailbox1_causes = COPY
  imapsieve_mailbox1_before = file:/etc/dovecot/sieve/report-spam.sieve

  # Learn ham when users move messages back from Spam to INBOX.
  imapsieve_mailbox2_name = INBOX
  imapsieve_mailbox2_from = Spam
  imapsieve_mailbox2_causes = COPY
  imapsieve_mailbox2_before = file:/etc/dovecot/sieve/report-ham.sieve

  # Some clients use Junk instead of Spam; train both directions too.
  imapsieve_mailbox3_name = Junk
  imapsieve_mailbox3_causes = COPY
  imapsieve_mailbox3_before = file:/etc/dovecot/sieve/report-spam.sieve

  imapsieve_mailbox4_name = INBOX
  imapsieve_mailbox4_from = Junk
  imapsieve_mailbox4_causes = COPY
  imapsieve_mailbox4_before = file:/etc/dovecot/sieve/report-ham.sieve
}
namespace inbox {
  inbox = yes
  mailbox Spam {
    auto = subscribe
    special_use = \Junk
  }
  mailbox Virus {
    auto = subscribe
  }
}

# ─── Plaintext IMAP listener para Roundcube (PHP 7.2 sem suporte TLS moderno) ──
service imap-login {
  inet_listener imap-plain {
    port = 10143
    ssl = no
  }
}
protocol imap {
  ssl = yes
}
